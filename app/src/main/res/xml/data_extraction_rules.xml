<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The downloaded neural model (~224 MB) is re-downloadable, keep it out of backups/transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
